{
  "name": "mucu",
  "version": "0.1.0",
  "description": "A shadcn/ui-style React component library with Tailwind CSS",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "storybook": "pnpm --filter registry storybook",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:storybook": "pnpm --filter registry test:storybook",
    "test:unit": "pnpm --filter registry test:unit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "prepare": "husky",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.2.10",
    "@storybook/addon-vitest": "^10.2.10",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.55.0",
    "vitest": "^4.0.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": "10.26.1"
  },
  "packageManager": "pnpm@10.26.1"
}
